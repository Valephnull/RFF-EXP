#version 450
#include <common.glsl>

#define DESC_PALETTE 2
#define DESC_TIME 3
#define DESC_ITERATION 5
#define DESC_STRIPE 6
#define DESC_SAMPLING 7
#define DESC_ITERATION_BUFFER_ACCESS writeonly

#include <desc_iteration.glsl>
#include <desc_palette.glsl>
#include <desc_time.glsl>
#include <desc_stripe.glsl>
#include <desc_sampling.glsl>

#include <utils_iteration.glsl>
#include <utils_palette.glsl>
#include <utils_stripe.glsl>
#include <utils_stochastic.glsl>

layout (set = 0, binding = 0) buffer Iteration2MapNormalSSBO {
    double iterations[];
} it2map_normal_settings;

layout (set = 0, binding = 1) buffer Iteration2MapZoomedSSBO {
    double iterations[];
} it2map_zoomed_settings;

layout (set = 1, binding = 0) uniform VideoUBO {
    float default_zoom_increment;
    float current_frame;
} video_settings;

layout (set = 4, binding = 0, rgba8) writeonly uniform image2D merged_image_output;

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

double get_iteration_normal(ivec2 iter_coord, ivec2 offset) {
    return it2map_normal_settings.iterations[get_iteration_index(iter_coord, offset)];
}

double get_iteration_zoomed(ivec2 iter_coord, ivec2 offset) {
    return it2map_zoomed_settings.iterations[get_iteration_index(iter_coord, offset)];
}

double get_iteration_normal(vec2 coordinate) {
    if (!sampling_settings.bilinear)
        return get_iteration_normal(ivec2(coordinate), ivec2(0));

    ivec2 base = ivec2(floor(coordinate));
    vec2 fraction = fract(coordinate);
    double lower = mix(get_iteration_normal(base, ivec2(0, 0)),
                       get_iteration_normal(base, ivec2(1, 0)), double(fraction.x));
    double upper = mix(get_iteration_normal(base, ivec2(0, 1)),
                       get_iteration_normal(base, ivec2(1, 1)), double(fraction.x));
    return mix(lower, upper, double(fraction.y));
}

double get_iteration_zoomed(vec2 coordinate) {
    if (!sampling_settings.bilinear)
        return get_iteration_zoomed(ivec2(coordinate), ivec2(0));

    ivec2 base = ivec2(floor(coordinate));
    vec2 fraction = fract(coordinate);
    double lower = mix(get_iteration_zoomed(base, ivec2(0, 0)),
                       get_iteration_zoomed(base, ivec2(1, 0)), double(fraction.x));
    double upper = mix(get_iteration_zoomed(base, ivec2(0, 1)),
                       get_iteration_zoomed(base, ivec2(1, 1)), double(fraction.x));
    return mix(lower, upper, double(fraction.y));
}

void set_iteration_output(ivec2 iter_coord, double value) {
    iteration_settings.iterations[get_iteration_index(iter_coord)] = value;
}

void main() {
    ivec2 output_coord = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, iteration_info_settings.extent)))
        return;

    vec2 center = vec2(iteration_info_settings.extent) / 2.0;
    float r = int(max(0, video_settings.current_frame)) - video_settings.current_frame;
    float normal_scale = pow(video_settings.default_zoom_increment, r + 1);
    float zoomed_scale = pow(video_settings.default_zoom_increment, r);
    uint sample_count = clamp(sampling_settings.sample_count, 1u, MAX_STOCHASTIC_SAMPLES);
    double iteration_total = 0.0;

    for (uint sample_index = 0u; sample_index < sample_count; ++sample_index) {
        vec2 jitter = sample_count > 1u ? stochastic_pixel_offset(output_coord, sample_index) : vec2(0.0);
        vec2 relative_coord = vec2(output_coord) + vec2(0.5) + jitter - center;
        vec2 normal_coord = relative_coord / normal_scale + center - vec2(0.5);
        vec2 zoomed_coord = relative_coord / zoomed_scale + center - vec2(0.5);

        double iteration = get_iteration_normal(normal_coord);
        bool zoomed_valid = zoomed_coord.x >= 0.0 && zoomed_coord.y >= 0.0 &&
                            zoomed_coord.x < float(iteration_info_settings.extent.x - 1) &&
                            zoomed_coord.y < float(iteration_info_settings.extent.y - 1);
        if (zoomed_valid) {
            double zoomed_iteration = get_iteration_zoomed(zoomed_coord);
            if (zoomed_iteration != 0.0)
                iteration = iteration * double(-r) + zoomed_iteration * double(r + 1.0);
        }

        iteration_total += iteration;
    }

    double iteration = iteration_total / double(sample_count);
    set_iteration_output(output_coord, iteration);
    imageStore(merged_image_output, output_coord,
               vec4(palette_get_color(iteration).rgb * stripe_get_multiplier(iteration), 1.0));
}
